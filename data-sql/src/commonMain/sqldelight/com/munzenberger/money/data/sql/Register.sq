selectInitialBalance:
SELECT initial_balance FROM Account WHERE id = ?;

selectTransactions:
SELECT
    t.id AS id,
    t.account_id AS account_id,
    t.payee_id AS payee_id,
    Payee.name AS payee_name,
    t.date AS date,
    t.created AS created,
    t.number AS number,
    t.memo AS memo,
    TransactionStatus.id AS status_id,
    TransactionStatus.value AS status_value
FROM "Transaction" AS t
LEFT JOIN Payee ON t.payee_id = Payee.id
JOIN TransactionStatus ON t.status_id = TransactionStatus.id
WHERE t.account_id = ?;

selectCategoryEntries:
SELECT
    CategoryEntry.id AS id,
    CategoryEntry.transaction_id AS transaction_id,
    CategoryEntry.category_id AS category_id,
    Category.name AS category_name,
    ParentCategory.name AS parent_category_name,
    CategoryEntry.amount AS amount,
    CategoryEntry.order_in_transaction AS order_in_transaction
FROM CategoryEntry
JOIN "Transaction" AS t ON CategoryEntry.transaction_id = t.id
JOIN Category ON CategoryEntry.category_id = Category.id
LEFT JOIN Category AS ParentCategory ON Category.parent_id = ParentCategory.id
WHERE t.account_id = ?;

selectTransferEntries:
SELECT
    TransferEntry.id AS id,
    TransferEntry.transaction_id AS transaction_id,
    TransferEntry.account_id AS account_id,
    Account.name AS account_name,
    TransferEntry.amount AS amount,
    TransferEntry.order_in_transaction AS order_in_transaction
FROM TransferEntry
JOIN "Transaction" AS t ON TransferEntry.transaction_id = t.id
JOIN Account ON TransferEntry.account_id = Account.id
WHERE t.account_id = ?;

selectTransfers:
SELECT
    TransferEntry.id AS id,
    TransferEntry.account_id AS account_id,
    t.payee_id AS payee_id,
    Payee.name AS payee_name,
    t.date AS date,
    t.created AS created,
    TransferEntry.amount AS amount,
    TransferEntry.number AS number,
    TransferEntry.memo AS memo,
    TransactionStatus.id AS status_id,
    TransactionStatus.value AS status_value
FROM TransferEntry
JOIN "Transaction" AS t ON TransferEntry.transaction_id = t.id
LEFT JOIN Payee ON t.payee_id = Payee.id
JOIN TransactionStatus ON TransferEntry.status_id = TransactionStatus.id
WHERE TransferEntry.account_id = ?;
